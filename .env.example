# Copy this file to .env and fill in real values locally.
# .env is gitignored and must never be committed.

# Required: OpenAI API key used by the Agents SDK for all agent/model calls.
OPENAI_API_KEY=your-key-here

# Optional: model id used by the agents (defaults to gpt-4.1-mini in code if unset).
OPENAI_MODEL=gpt-4.1-mini

# MongoDB (local Docker via docker-compose.yml by default).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agentic_trip_planner

# Opik (Comet-hosted) tracing, run alongside the OpenAI native tracing dashboard.
OPIK_API_KEY=your-opik-api-key-here
OPIK_WORKSPACE=your-comet-workspace
OPIK_PROJECT_NAME=agentic-trip-planner
